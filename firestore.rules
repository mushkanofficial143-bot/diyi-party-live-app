rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isHost(roomId) {
      return isAuthenticated() && get(/databases/$(database)/documents/party_rooms/$(roomId)).data.hostId == request.auth.uid;
    }
    
    // Users Collection
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if isOwner(userId);
      
      // Allow admins to read all user profiles
      allow read: if isAdmin();
      
      // Allow users to update their own profile (limited fields)
      allow update: if isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'avatar', 'bio', 'status']);
      
      // Allow creation of new user documents
      allow create: if isOwner(userId) && 
        request.resource.data.role == 'user' &&
        request.resource.data.coinsBalance == 0 &&
        request.resource.data.diamondsBalance == 0;
      
      // Admin only operations
      allow delete: if isAdmin();
      allow write: if isAdmin();
      
      // Subcollection: User Transactions
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow delete: if isAdmin();
      }
      
      // Subcollection: User Followers
      match /followers/{followerId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow delete: if isOwner(userId) || isOwner(followerId);
      }
    }
    
    // Party Rooms Collection
    match /party_rooms/{roomId} {
      // Allow authenticated users to read active rooms
      allow read: if isAuthenticated() && resource.data.status == 'active';
      
      // Allow admins to read all rooms
      allow read: if isAdmin();
      
      // Allow room host to create and update their rooms
      allow create: if isAuthenticated() &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.onlineCount == 0;
      
      allow update: if isHost(roomId) &&
        request.resource.data.hostId == resource.data.hostId;
      
      // Allow host or admin to end room
      allow delete: if isHost(roomId) || isAdmin();
      
      // Subcollection: Room Messages
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.roomId == roomId;
        allow delete: if isOwner(request.resource.data.senderId) || isAdmin();
      }
      
      // Subcollection: Room Viewers
      match /viewers/{viewerId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isOwner(viewerId) || isHost(roomId);
      }
      
      // Subcollection: Room Gifts
      match /gifts/{giftId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid;
      }
    }
    
    // Wallet Collection
    match /wallets/{userId} {
      // Users can only read their own wallet
      allow read: if isOwner(userId);
      
      // Admins can read all wallets
      allow read: if isAdmin();
      
      // Only backend/admin can update wallet balances
      allow write: if isAdmin();
      
      // Subcollection: Coin Transactions
      match /coin_transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
      }
      
      // Subcollection: Diamond Transactions
      match /diamond_transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
      }
    }
    
    // Withdrawal Requests Collection
    match /withdrawals/{withdrawalId} {
      // Users can read their own withdrawals
      allow read: if isOwner(resource.data.userId);
      
      // Admins can read all withdrawals
      allow read: if isAdmin();
      
      // Users can create withdrawal requests
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount >= 100;
      
      // Only admins can update withdrawal status
      allow update: if isAdmin() &&
        (request.resource.data.status == 'approved' ||
         request.resource.data.status == 'paid' ||
         request.resource.data.status == 'rejected');
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // Gifts Collection
    match /gifts/{giftId} {
      // Allow reading gifts
      allow read: if isAuthenticated();
      
      // Only backend should create gifts
      allow write: if isAdmin();
    }
    
    // Gift History (User Sent Gifts)
    match /users/{userId}/gift_history/{historyId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
    }
    
    // Gift Received (User Received Gifts)
    match /users/{userId}/gifts_received/{giftId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
    }
    
    // Reports Collection
    match /reports/{reportId} {
      // Users can create reports
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;
      
      // Users can read their own reports
      allow read: if isOwner(resource.data.reporterId);
      
      // Admins can read and update all reports
      allow read, update: if isAdmin();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // Blocks Collection (User Blocking)
    match /blocks/{blockId} {
      // Users can read their own blocks
      allow read: if isOwner(resource.data.blockerId) || isOwner(resource.data.blockedId);
      
      // Users can create blocks
      allow create: if isAuthenticated() &&
        request.resource.data.blockerId == request.auth.uid;
      
      // Users can delete their own blocks
      allow delete: if isOwner(resource.data.blockerId) || isAdmin();
    }
    
    // Notifications Collection
    match /notifications/{userId}/messages/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(userId);
      
      // System/Backend creates notifications
      allow create: if isAdmin();
      
      // Users can delete their own notifications
      allow delete: if isOwner(userId);
    }
    
    // Admin Logs Collection
    match /admin_logs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();
      
      // Only admins can create logs
      allow create: if isAdmin();
      
      // Only admins can delete logs
      allow delete: if isAdmin();
    }
    
    // Config Collection (App Configuration)
    match /config/{document=**} {
      // All authenticated users can read config
      allow read: if isAuthenticated();
      
      // Only admins can write config
      allow write: if isAdmin();
    }
  }
}
